# Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys.
# Leave both empty to run without the captcha (local development).
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# API port (the Vite dev server proxies /api to it)
API_PORT=3001

# Password for the /admin page (view and download responses).
# At least 10 characters. Leave empty to keep the admin page switched off.
ADMIN_PASSWORD=

# Set to 1 when deployed behind a hosting provider's proxy (most hosts)
# TRUST_PROXY=1

# Hosted database (Turso). Required on Vercel, where there is no disk to keep a file on.
# Leave unset locally to use a SQLite file in ./data instead.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Where the local SQLite file and exports are kept (default: ./data)
# DATA_DIR=
